<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Study Saga - Educational Combat Game</title>
    <link rel="stylesheet" href="{{ url_for('static', filename='css/style.css') }}">
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
</head>
<body>
    <!-- ==================== TASK 2.1: MAIN MENU SCREEN ==================== -->
    <div data-screen="main_menu" style="display: block;">
        <div class="menu-container">
            <div class="menu-sidebar">
                <h1 class="game-title">STUDY SAGA</h1>
                <p class="game-subtitle">Learn Through Combat</p>
                <div class="menu-buttons">
                    <button id="start-game-btn" class="menu-btn start-btn" onclick="(async()=>{let r=await fetch('/api/start-game',{method:'POST',headers:{'Content-Type':'application/json'}});let d=await r.json();if(d.status==='success'){window.gameId=d.game_id;document.querySelector('[data-screen=main_menu]').style.display='none';document.querySelector('[data-screen=syllabus_select]').style.display='block';let s=await fetch('/api/syllabi');let sd=await s.json();let c=document.getElementById('syllabi-grid');c.innerHTML='';sd.syllabi.forEach(x=>{let div=document.createElement('div');div.className='syllabus-card';div.innerHTML='<h3>'+x.title+'</h3><p>'+x.description+'</p>';let btn=document.createElement('button');btn.className='select-btn';btn.textContent='Select';btn.onclick=()=>{fetch('/api/start-combat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({game_id:window.gameId,syllabus_id:x.id})}).then(r=>r.json()).then(d=>{if(d.status==='success'){document.querySelector('[data-screen=syllabus_select]').style.display='none';document.querySelector('[data-screen=combat]').style.display='block';}else alert('Error:'+d.message);})};div.appendChild(btn);c.appendChild(div);});} else alert('Could not start game');})()">
                        <span class="btn-text">START GAME</span>
                        <div class="btn-glow"></div>
                    </button>
                    
                    <button id="options-btn" class="menu-btn options-btn">
                        <span class="btn-text">OPTIONS</span>
                        <div class="btn-glow"></div>
                    </button>
                </div>
            </div>

            <div class="menu-content">
                <div class="welcome-text">
                    <h2>Welcome to Study Saga</h2>
                    <p>Test your knowledge through combat! Answer questions correctly to defeat enemies and learn concepts through gameplay.</p>
                    <div class="features">
                        <div class="feature">
                            <h3>Combat-Based Learning</h3>
                            <p>Every battle sharpens your knowledge</p>
                        </div>
                        <div class="feature">
                            <h3>Multiple Subjects</h3>
                            <p>Choose from various subjects to learn</p>
                        </div>
                        <div class="feature">
                            <h3>Strategic Abilities</h3>
                            <p>Use abilities to gain an advantage</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ==================== TASK 2.2: SYLLABUS SELECT SCREEN ==================== -->
    <div data-screen="syllabus_select" style="display: none;">
        <div class="research-lab-container">
            <div class="research-lab-header">
                <h1>Research Lab</h1>
                <p>Select a syllabus to begin your battle</p>
                <button id="back-to-menu-btn" class="back-btn">← Back to Menu</button>
            </div>

            <div id="syllabi-grid" class="syllabi-grid">
                <!-- Syllabi cards will be inserted here -->
            </div>
        </div>
    </div>

    <!-- ==================== TASK 2.3 & 2.4 & 2.5: COMBAT SCREEN ==================== -->
    <div data-screen="combat" style="display: none;">
        <div class="combat-container">
            <!-- Top Status Bar -->
            <div class="status-bar">
                <div class="turn-info">
                    <span id="turn-count">Turn 0</span>
                </div>
            </div>

            <!-- Game Field -->
            <div class="game-field">
                <!-- Player Side -->
                <div class="player-side">
                    <div class="character-display">
                        <div class="player-sprite">🧠</div>
                        <div class="player-name" id="player-name">Knowledge Keeper</div>
                    </div>
                </div>

                <!-- Center Divider -->
                <div class="field-center"></div>

                <!-- Enemy Side -->
                <div class="enemy-side">
                    <div class="character-display">
                        <div class="enemy-sprite">👹</div>
                        <div class="enemy-name" id="enemy-name">Misconception Golem</div>
                    </div>
                </div>
            </div>

            <!-- HUD Panels -->
            <div class="hud-panels">
                <!-- Player HUD -->
                <div class="hud-panel player-hud">
                    <h3>Your Stats</h3>
                    <div class="stat-row">
                        <label>HP:</label>
                        <span id="player-hp">100/100</span>
                        <div class="progress-bar">
                            <div id="player-hp-bar" class="progress-fill hp-bar" style="width: 100%"></div>
                        </div>
                    </div>
                    <div class="stat-row">
                        <label>CAP:</label>
                        <span id="player-cap">10/10</span>
                        <div class="progress-bar">
                            <div id="player-cap-bar" class="progress-fill cap-bar" style="width: 100%"></div>
                        </div>
                    </div>
                </div>

                <!-- Enemy HUD -->
                <div class="hud-panel enemy-hud">
                    <h3>Enemy Stats</h3>
                    <div class="stat-row">
                        <label>HP:</label>
                        <span id="enemy-hp">150/150</span>
                        <div class="progress-bar">
                            <div id="enemy-hp-bar" class="progress-fill hp-bar" style="width: 100%"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Bar -->
            <div class="action-bar">
                <button id="attack-btn" class="action-btn attack-btn">
                    <span class="action-name">ATTACK</span>
                    <span class="action-cost">CAP: 3</span>
                </button>
                <button id="ability-btn" class="action-btn ability-btn">
                    <span class="action-name">ABILITY</span>
                    <span class="action-cost">CAP: 5</span>
                </button>
                <button id="recharge-btn" class="action-btn recharge-btn">
                    <span class="action-name">RECHARGE</span>
                    <span class="action-cost">+5 CAP</span>
                </button>
            </div>
        </div>
    </div>

    <!-- TASK 2.4: QUIZ MODAL -->
    <div id="quiz-modal" class="modal" style="display: none;">
        <div class="modal-content quiz-modal-content">
            <span class="close-modal">&times;</span>
            <h2>Answer the Question</h2>
            <p id="quiz-question" class="quiz-question"></p>
            <div id="quiz-options" class="quiz-options">
                <!-- Options will be inserted here -->
            </div>
        </div>
    </div>

    <!-- TASK 2.5: FEEDBACK MODAL -->
    <div id="feedback-modal" class="modal" style="display: none;">
        <div class="modal-content feedback-modal-content">
            <span class="close-modal">&times;</span>
            <h2 id="feedback-title" class="feedback-title"></h2>
            <p id="feedback-message" class="feedback-message"></p>
            <div id="feedback-details" class="feedback-details"></div>
            <button id="feedback-continue-btn" class="btn-primary">Continue</button>
        </div>
    </div>

    <!-- ==================== TASK 2.6: VICTORY SCREEN ==================== -->
    <div data-screen="victory" style="display: none;">
        <div class="game-over-container victory-container">
            <div class="game-over-content">
                <h1 class="victory-title">🎉 VICTORY! 🎉</h1>
                <p class="victory-message">You have defeated the enemy and expanded your knowledge!</p>
                <div class="victory-stats">
                    <p>Excellent performance in this battle!</p>
                </div>
                <button id="victory-play-again-btn" class="btn-large play-again-btn">
                    Play Again
                </button>
            </div>
        </div>
    </div>

    <!-- ==================== TASK 2.6: DEFEAT SCREEN ==================== -->
    <div data-screen="defeat" style="display: none;">
        <div class="game-over-container defeat-container">
            <div class="game-over-content">
                <h1 class="defeat-title">💀 DEFEAT 💀</h1>
                <p class="defeat-message">You have been defeated by the enemy. Study harder and try again!</p>
                <div class="defeat-stats">
                    <p>Don't give up! Practice makes perfect.</p>
                </div>
                <button id="defeat-play-again-btn" class="btn-large play-again-btn">
                    Try Again
                </button>
            </div>
        </div>
    </div>

    <!-- OPTIONS MODAL (from original) -->
    <div id="optionsModal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Game Options</h2>
            <div class="options-form">
                <div class="option-group">
                    <label for="difficulty">Difficulty:</label>
                    <select id="difficulty">
                        <option value="Easy">Easy</option>
                        <option value="Medium">Medium</option>
                        <option value="Hard">Hard</option>
                    </select>
                </div>
                
                <div class="option-group">
                    <label for="soundEnabled">Sound:</label>
                    <input type="checkbox" id="soundEnabled" checked>
                </div>
                
                <div class="option-group">
                    <label for="musicVolume">Music Volume:</label>
                    <input type="range" id="musicVolume" min="0" max="100" value="70">
                    <span id="musicVolumeValue">70%</span>
                </div>
                
                <div class="option-group">
                    <label for="sfxVolume">SFX Volume:</label>
                    <input type="range" id="sfxVolume" min="0" max="100" value="80">
                    <span id="sfxVolumeValue">80%</span>
                </div>
                
                <button class="save-btn" onclick="saveOptions()">Save Options</button>
            </div>
        </div>
    </div>

    <script src="{{ url_for('static', filename='js/models.js') }}"></script>
    <script src="{{ url_for('static', filename='js/script.js') }}"></script>
    <script>
        // Minimal inline wiring (bypasses external init)
        function updateCombatUIInline(state) {
            document.getElementById('player-hp').textContent = `${state.player.current_hp}/${state.player.max_hp}`;
            document.getElementById('player-cap').textContent = `${state.player.current_cap}/${state.player.max_cap}`;
            document.getElementById('enemy-hp').textContent = `${state.enemy.current_hp}/${state.enemy.max_hp}`;
            document.getElementById('enemy-name').textContent = state.enemy.name;
            const hpPct = Math.max(0, Math.min(100, (state.player.current_hp / state.player.max_hp) * 100));
            const capPct = Math.max(0, Math.min(100, (state.player.current_cap / state.player.max_cap) * 100));
            const enemyPct = Math.max(0, Math.min(100, (state.enemy.current_hp / state.enemy.max_hp) * 100));
            document.getElementById('player-hp-bar').style.width = hpPct + '%';
            document.getElementById('player-cap-bar').style.width = capPct + '%';
            document.getElementById('enemy-hp-bar').style.width = enemyPct + '%';
        }

        function selectSyllabusInline(syllabusId) {
            if (!window.currentGameId) {
                alert('Game ID missing. Click START GAME again.');
                return;
            }

            fetch('/api/start-combat', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    game_id: window.currentGameId,
                    syllabus_id: syllabusId
                })
            })
            .then(res => res.json())
            .then(data => {
                console.log('start-combat', data);
                if (data.status === 'success') {
                    document.querySelector('[data-screen=syllabus_select]').style.display = 'none';
                    document.querySelector('[data-screen=combat]').style.display = 'block';
                    updateCombatUIInline(data.combat_state);
                } else {
                    alert('Could not start combat: ' + data.message);
                }
            })
            .catch(err => { console.error(err); alert('Error: ' + err); });
        }

        function loadSyllabiInline() {
            fetch('/api/syllabi')
            .then(res => res.json())
            .then(data => {
                console.log('syllabi', data);
                if (data.status === 'success') {
                    const container = document.getElementById('syllabi-grid');
                    container.innerHTML = '';
                    data.syllabi.forEach(syllabus => {
                        const card = document.createElement('div');
                        card.className = 'syllabus-card';
                        card.innerHTML = `<h3>${syllabus.title}</h3><p>${syllabus.description}</p>`;
                        const btn = document.createElement('button');
                        btn.className = 'select-btn';
                        btn.textContent = 'Select';
                        btn.addEventListener('click', () => selectSyllabusInline(syllabus.id));
                        card.appendChild(btn);
                        container.appendChild(card);
                    });
                } else {
                    alert('Could not load syllabi: ' + data.message);
                }
            })
            .catch(err => { console.error(err); alert('Error: ' + err); });
        }

        function startGameInline() {
            console.log('startGameInline called');
            fetch('/api/start-game', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'}
            })
            .then(res => res.json())
            .then(data => {
                console.log('start-game response', data);
                if (data.status === 'success') {
                    window.currentGameId = data.game_id;
                    document.querySelector('[data-screen=main_menu]').style.display = 'none';
                    document.querySelector('[data-screen=syllabus_select]').style.display = 'block';
                    loadSyllabiInline();
                } else {
                    alert('Could not start game: ' + data.message);
                }
            })
            .catch(err => { console.error(err); alert('Error: ' + err); });
        }

        // Attach handler after DOM ready (works even if external scripts fail)
        document.addEventListener('DOMContentLoaded', () => {
            const startBtn = document.getElementById('start-game-btn');
            if (startBtn) {
                startBtn.addEventListener('click', () => {
                    alert('Starting game...');
                    startGameInline();
                });
            }
        });
    </script>
</body>
</html>
